{
    "files.associations": {
        "*.ino": "cpp",
        "*.cpp": "cpp",
        "*.h": "cpp"
    },
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed"
    ],
    "files.exclude": {
        "**/build": true,
        "**/.git": true
    }
}